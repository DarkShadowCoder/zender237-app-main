{
  "cli": {
    "version": ">= 16.18.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },

  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",

      "android": {
        "buildType": "apk"
      }
    },

    "preview": {
      "distribution": "internal",

      "android": {
        "buildType": "apk"
      },

      "env": {
        "APP_ENV": "preview"
      }
    },

    "production": {
      "autoIncrement": true,

      "env": {
        "APP_ENV": "production"
      },

      "android": {
        "buildType": "app-bundle"
      }
    }
  },

  "submit": {
    "production": {}
  }
}